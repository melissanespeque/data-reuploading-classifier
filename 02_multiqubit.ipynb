      "\u001b[36mFile \u001b[39m\u001b[32m~/LCP-B/data-reuploading-classifier/weight_fid_minimization.py:208\u001b[39m, in \u001b[36m_scipy_minimizing\u001b[39m\u001b[34m(params, hypars, train_data, reprs, entanglement)\u001b[39m\n\u001b[32m    196\u001b[39m \u001b[38;5;250m\u001b[39m\u001b[33;03m\"\"\"\u001b[39;00m\n\u001b[32m    197\u001b[39m \u001b[33;03mThis function returns the chi^2 function for using scipy\u001b[39;00m\n\u001b[32m    198\u001b[39m \u001b[33;03mINPUT:\u001b[39;00m\n\u001b[32m   (...)\u001b[39m\u001b[32m    205\u001b[39m \u001b[33;03m    - Av_chi_square, which is the function we want to minimize\u001b[39;00m\n\u001b[32m    206\u001b[39m \u001b[33;03m\"\"\"\u001b[39;00m\n\u001b[32m    207\u001b[39m theta, alpha, weight = _translate_from_scipy(params, hypars)\n\u001b[32m--> \u001b[39m\u001b[32m208\u001b[39m \u001b[38;5;28;01mreturn\u001b[39;00m \u001b[43mAv_Chi_Square\u001b[49m\u001b[43m(\u001b[49m\u001b[43mtheta\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43malpha\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43mweight\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43mtrain_data\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43mreprs\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43mentanglement\u001b[49m\u001b[43m)\u001b[49m\n",
      "\u001b[36mFile \u001b[39m\u001b[32m~/LCP-B/data-reuploading-classifier/weight_fid_minimization.py:162\u001b[39m, in \u001b[36mAv_Chi_Square\u001b[39m\u001b[34m(theta, alpha, weight, data, reprs, entanglement)\u001b[39m\n\u001b[32m    160\u001b[39m Av_Chi = \u001b[32m0\u001b[39m\n\u001b[32m    161\u001b[39m \u001b[38;5;28;01mfor\u001b[39;00m d \u001b[38;5;129;01min\u001b[39;00m data:\n\u001b[32m--> \u001b[39m\u001b[32m162\u001b[39m     Av_Chi += \u001b[43m_chi\u001b[49m\u001b[43m(\u001b[49m\u001b[43mtheta\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43malpha\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43mweight\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43md\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43mreprs\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43mentanglement\u001b[49m\u001b[43m)\u001b[49m\n\u001b[32m    164\u001b[39m \u001b[38;5;28;01mreturn\u001b[39;00m Av_Chi / \u001b[38;5;28mlen\u001b[39m(data)\n",
      "\u001b[36mFile \u001b[39m\u001b[32m~/LCP-B/data-reuploading-classifier/weight_fid_minimization.py:133\u001b[39m, in \u001b[36m_chi\u001b[39m\u001b[34m(theta, alpha, weight, d, reprs, entanglement)\u001b[39m\n\u001b[32m    131\u001b[39m x, y = d\n\u001b[32m    132\u001b[39m theta_aux = code_coords(theta, alpha, x)\n\u001b[32m--> \u001b[39m\u001b[32m133\u001b[39m fids = \u001b[43mmat_fidelities\u001b[49m\u001b[43m(\u001b[49m\u001b[43mtheta_aux\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43mweight\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43mreprs\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43mentanglement\u001b[49m\u001b[43m)\u001b[49m\n\u001b[32m    134\u001b[39m w_fid = w_fidelities(fids, weight)\n\u001b[32m    135\u001b[39m \u001b[38;5;28;01mif\u001b[39;00m \u001b[38;5;28mlen\u001b[39m(w_fid) == \u001b[32m4\u001b[39m:\n",
      "\u001b[36mFile \u001b[39m\u001b[32m~/LCP-B/data-reuploading-classifier/weight_fid_minimization.py:89\u001b[39m, in \u001b[36mmat_fidelities\u001b[39m\u001b[34m(theta_aux, weight, reprs, entanglement, return_circuit)\u001b[39m\n\u001b[32m     87\u001b[39m Fidelities = np.empty(weight.shape)\n\u001b[32m     88\u001b[39m C = circuit(theta_aux, entanglement)\n\u001b[32m---> \u001b[39m\u001b[32m89\u001b[39m sv = \u001b[43mStatevector\u001b[49m\u001b[43m(\u001b[49m\u001b[43mC\u001b[49m\u001b[43m)\u001b[49m\n\u001b[32m     90\u001b[39m dm = DensityMatrix(sv)\n\u001b[32m     92\u001b[39m \u001b[38;5;28;01mfor\u001b[39;00m q \u001b[38;5;129;01min\u001b[39;00m \u001b[38;5;28mrange\u001b[39m(qubits):\n",
      "\u001b[36mFile \u001b[39m\u001b[32m~/opt/anaconda3/envs/LCPB/lib/python3.12/site-packages/qiskit/quantum_info/states/statevector.py:101\u001b[39m, in \u001b[36mStatevector.__init__\u001b[39m\u001b[34m(self, data, dims)\u001b[39m\n\u001b[32m     99\u001b[39m     \u001b[38;5;28mself\u001b[39m._data = np.ravel(data.data)\n\u001b[32m    100\u001b[39m \u001b[38;5;28;01melif\u001b[39;00m \u001b[38;5;28misinstance\u001b[39m(data, (QuantumCircuit, Instruction)):\n\u001b[32m--> \u001b[39m\u001b[32m101\u001b[39m     \u001b[38;5;28mself\u001b[39m._data = \u001b[43mStatevector\u001b[49m\u001b[43m.\u001b[49m\u001b[43mfrom_instruction\u001b[49m\u001b[43m(\u001b[49m\u001b[43mdata\u001b[49m\u001b[43m)\u001b[49m.data\n\u001b[32m    102\u001b[39m \u001b[38;5;28;01melse\u001b[39;00m:\n\u001b[32m    103\u001b[39m     \u001b[38;5;28;01mraise\u001b[39;00m QiskitError(\u001b[33m\"\u001b[39m\u001b[33mInvalid input data format for Statevector\u001b[39m\u001b[33m\"\u001b[39m)\n",
      "\u001b[36mFile \u001b[39m\u001b[32m~/opt/anaconda3/envs/LCPB/lib/python3.12/site-packages/qiskit/quantum_info/states/statevector.py:841\u001b[39m, in \u001b[36mStatevector.from_instruction\u001b[39m\u001b[34m(cls, instruction)\u001b[39m\n\u001b[32m    839\u001b[39m \u001b[38;5;66;03m# Convert circuit to an instruction\u001b[39;00m\n\u001b[32m    840\u001b[39m \u001b[38;5;28;01mif\u001b[39;00m \u001b[38;5;28misinstance\u001b[39m(instruction, QuantumCircuit):\n\u001b[32m--> \u001b[39m\u001b[32m841\u001b[39m     instruction = \u001b[43minstruction\u001b[49m\u001b[43m.\u001b[49m\u001b[43mto_instruction\u001b[49m\u001b[43m(\u001b[49m\u001b[43m)\u001b[49m\n\u001b[32m    842\u001b[39m \u001b[38;5;66;03m# Initialize an the statevector in the all |0> state\u001b[39;00m\n\u001b[32m    843\u001b[39m init = np.zeros(\u001b[32m2\u001b[39m**instruction.num_qubits, dtype=\u001b[38;5;28mcomplex\u001b[39m)\n",
      "\u001b[36mFile \u001b[39m\u001b[32m~/opt/anaconda3/envs/LCPB/lib/python3.12/site-packages/qiskit/circuit/quantumcircuit.py:3790\u001b[39m, in \u001b[36mQuantumCircuit.to_instruction\u001b[39m\u001b[34m(self, parameter_map, label)\u001b[39m\n\u001b[32m   3770\u001b[39m \u001b[38;5;250m\u001b[39m\u001b[33;03m\"\"\"Create an :class:`~.circuit.Instruction` out of this circuit.\u001b[39;00m\n\u001b[32m   3771\u001b[39m \n\u001b[32m   3772\u001b[39m \u001b[33;03m.. seealso::\u001b[39;00m\n\u001b[32m   (...)\u001b[39m\u001b[32m   3785\u001b[39m \u001b[33;03m        decomposed back).\u001b[39;00m\n\u001b[32m   3786\u001b[39m \u001b[33;03m\"\"\"\u001b[39;00m\n\u001b[32m   3788\u001b[39m \u001b[38;5;28;01mfrom\u001b[39;00m\u001b[38;5;250m \u001b[39m\u001b[34;01mqiskit\u001b[39;00m\u001b[34;01m.\u001b[39;00m\u001b[34;01mconverters\u001b[39;00m\u001b[34;01m.\u001b[39;00m\u001b[34;01mcircuit_to_instruction\u001b[39;00m\u001b[38;5;250m \u001b[39m\u001b[38;5;28;01mimport\u001b[39;00m circuit_to_instruction\n\u001b[32m-> \u001b[39m\u001b[32m3790\u001b[39m \u001b[38;5;28;01mreturn\u001b[39;00m \u001b[43mcircuit_to_instruction\u001b[49m\u001b[43m(\u001b[49m\u001b[38;5;28;43mself\u001b[39;49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43mparameter_map\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43mlabel\u001b[49m\u001b[43m=\u001b[49m\u001b[43mlabel\u001b[49m\u001b[43m)\u001b[49m\n",
      "\u001b[36mFile \u001b[39m\u001b[32m~/opt/anaconda3/envs/LCPB/lib/python3.12/site-packages/qiskit/converters/circuit_to_instruction.py:112\u001b[39m, in \u001b[36mcircuit_to_instruction\u001b[39m\u001b[34m(circuit, parameter_map, equivalence_library, label)\u001b[39m\n\u001b[32m    103\u001b[39m out_instruction = Instruction(\n\u001b[32m    104\u001b[39m     name=circuit.name,\n\u001b[32m    105\u001b[39m     num_qubits=circuit.num_qubits,\n\u001b[32m   (...)\u001b[39m\u001b[32m    108\u001b[39m     label=label,\n\u001b[32m    109\u001b[39m )\n\u001b[32m    110\u001b[39m out_instruction._condition = \u001b[38;5;28;01mNone\u001b[39;00m\n\u001b[32m--> \u001b[39m\u001b[32m112\u001b[39m target = \u001b[43mcircuit\u001b[49m\u001b[43m.\u001b[49m\u001b[43massign_parameters\u001b[49m\u001b[43m(\u001b[49m\u001b[43mparameter_dict\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43minplace\u001b[49m\u001b[43m=\u001b[49m\u001b[38;5;28;43;01mFalse\u001b[39;49;00m\u001b[43m)\u001b[49m\n\u001b[32m    114\u001b[39m \u001b[38;5;28;01mif\u001b[39;00m equivalence_library \u001b[38;5;129;01mis\u001b[39;00m \u001b[38;5;129;01mnot\u001b[39;00m \u001b[38;5;28;01mNone\u001b[39;00m:\n\u001b[32m    115\u001b[39m     equivalence_library.add_equivalence(out_instruction, target)\n",
      "\u001b[36mFile \u001b[39m\u001b[32m~/opt/anaconda3/envs/LCPB/lib/python3.12/site-packages/qiskit/circuit/quantumcircuit.py:5045\u001b[39m, in \u001b[36mQuantumCircuit.assign_parameters\u001b[39m\u001b[34m(self, parameters, inplace, flat_input, strict)\u001b[39m\n\u001b[32m   5040\u001b[39m \u001b[38;5;28;01mif\u001b[39;00m \u001b[38;5;129;01mnot\u001b[39;00m \u001b[38;5;28misinstance\u001b[39m(parameters, \u001b[38;5;28mdict\u001b[39m):\n\u001b[32m   5041\u001b[39m     \u001b[38;5;66;03m# We're going to need to access the sorted order within the inner Rust method on\u001b[39;00m\n\u001b[32m   5042\u001b[39m     \u001b[38;5;66;03m# `target`, so warm up our own cache first so that subsequent calls to\u001b[39;00m\n\u001b[32m   5043\u001b[39m     \u001b[38;5;66;03m# `assign_parameters` on `self` benefit as well.\u001b[39;00m\n\u001b[32m   5044\u001b[39m     _ = \u001b[38;5;28mself\u001b[39m._data.parameters\n\u001b[32m-> \u001b[39m\u001b[32m5045\u001b[39m target = \u001b[38;5;28;43mself\u001b[39;49m\u001b[43m.\u001b[49m\u001b[43mcopy\u001b[49m\u001b[43m(\u001b[49m\u001b[43m)\u001b[49m\n\u001b[32m   5046\u001b[39m target._increment_instances()\n\u001b[32m   5047\u001b[39m target._name_update()\n",
      "\u001b[36mFile \u001b[39m\u001b[32m~/opt/anaconda3/envs/LCPB/lib/python3.12/site-packages/qiskit/circuit/quantumcircuit.py:4346\u001b[39m, in \u001b[36mQuantumCircuit.copy\u001b[39m\u001b[34m(self, name)\u001b[39m\n\u001b[32m   4343\u001b[39m \u001b[38;5;66;03m# vars_mode is \"drop\" since ``cpy._data`` is overridden anyway with the call to copy,\u001b[39;00m\n\u001b[32m   4344\u001b[39m \u001b[38;5;66;03m# so no need to copy variables in this call.\u001b[39;00m\n\u001b[32m   4345\u001b[39m cpy = \u001b[38;5;28mself\u001b[39m.copy_empty_like(name, vars_mode=\u001b[33m\"\u001b[39m\u001b[33mdrop\u001b[39m\u001b[33m\"\u001b[39m)\n\u001b[32m-> \u001b[39m\u001b[32m4346\u001b[39m cpy._data = \u001b[38;5;28;43mself\u001b[39;49m\u001b[43m.\u001b[49m\u001b[43m_data\u001b[49m\u001b[43m.\u001b[49m\u001b[43mcopy\u001b[49m\u001b[43m(\u001b[49m\u001b[43m)\u001b[49m\n\u001b[32m   4347\u001b[39m \u001b[38;5;28;01mreturn\u001b[39;00m cpy\n",
      "\u001b[31mKeyboardInterrupt\u001b[39m: "
     ]
